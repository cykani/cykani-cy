# =============================================================================
# Cykani — Local Development Environment
# Copy this file to .env and fill in the values.
# =============================================================================

# Database
PG_PASSWORD=your_secure_password_here

# Secrets — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_64_char_hex_secret_here
API_KEY_SECRET=your_64_char_hex_secret_here

# Auth (Next-Auth)
AUTH_SECRET=your_auth_secret_here
AUTH_URL=http://localhost:3001

# Google OAuth (optional for local dev)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# GitHub OAuth (optional for local dev)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# =============================================================================
# LLM Provider — pick ONE and fill in the key
# =============================================================================

# Option 1 (DEFAULT): Hermes 3 via OpenRouter — free tier, no setup needed
# Get free key at: https://openrouter.ai (sign up, go to Keys)
# Model: nousresearch/hermes-3-llama-3.1-405b (free tier available)
LLM_PROVIDER=hermes
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Option 2: Groq — fastest inference, generous free tier (14,400 req/day)
# Get free key at: https://console.groq.com
# Uncomment to use:
# LLM_PROVIDER=groq
# GROQ_API_KEY=gsk_your-key-here

# Option 3: OpenAI — highest quality, paid
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your-key-here

# =============================================================================
# Browser (cykani-stealth binary)
# =============================================================================

# The Docker image name for cykani-browser (private repo, built separately)
# Build it first: docker build -t cykani-browser:latest /path/to/cykani-browser
BROWSER_IMAGE=cykani-browser:latest

# Max concurrent sessions per organisation
MAX_SESSIONS_PER_ORG=5

# =============================================================================
# Billing (optional — leave empty to skip)
# =============================================================================
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_WEBHOOK_SECRET=

# =============================================================================
# Ports (defaults are fine for local dev)
# =============================================================================
API_PORT=3000
WEB_PORT=3001
